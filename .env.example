# Used by docker-compose.yml (production)

# Generate with: docker compose run --rm api php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost

DB_DATABASE=gemastik
DB_USERNAME=gemastik
DB_PASSWORD=

WEB_PORT=3000

# TelaahBareng. Generate each with: openssl rand -hex 32
# Internal key: shared by api and web; Laravel accepts TelaahBareng writes only with it.
TELAAH_INTERNAL_KEY=
# Signing key: web only; signs the analysis results that can become posts.
TELAAH_SIGNING_KEY=

# TelaahLoker quota (optional). New sessions per account per day, reset at 00:00 WIB.
QUOTA_DAILY_SESSIONS=5
# Accounts without limits, e.g. for the final's demo: comma-separated emails
QUOTA_EXEMPT_EMAILS=
