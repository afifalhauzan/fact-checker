# Salin menjadi .env.local lalu isi key-nya. Jangan pernah commit .env.local.

# Gemini (wajib). Tanpa key ini, analisis jatuh ke pemeriksaan berbasis aturan.
GOOGLE_GENERATIVE_AI_API_KEY=

# Model Gemini global (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Model per tahap pipeline (opsional, menimpa GEMINI_MODEL untuk tahap itu).
# GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
# GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
# GEMINI_ROUTER_MODEL=gemini-2.5-flash-lite
# GEMINI_FOLLOW_UP_MODEL=gemini-2.5-flash
# GEMINI_ACTION_MODEL=gemini-2.5-flash

# Pencarian web untuk verifikasi perusahaan (opsional). Tanpa key ini, pencarian dilewati.
TAVILY_API_KEY=

# Alternatif provider jika tidak memakai Gemini (opsional, belum diuji penuh).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
