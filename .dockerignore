# Build context is the repo root (see web/Dockerfile), so web/.dockerignore is not applied.
.git/
.claude/
.devtools/
docs/
api/

**/node_modules/
**/.next/
**/out/
**/.vercel/
**/*.tsbuildinfo

# Environment variables are passed at runtime, never baked into the image
**/.env
**/.env.*
!**/.env.example

**/*.log
**/.DS_Store
